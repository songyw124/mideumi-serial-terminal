{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UART Viewer",
  "version": "0.1.0",
  "identifier": "dev.local.uart-viewer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UART Viewer",
        "width": 1100,
        "height": 700,
        "minWidth": 560,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
